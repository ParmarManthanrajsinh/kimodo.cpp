# Kimodo Studio — C++23 coding style
# Apply with: clang-format -i $(git ls-files 'src/**/*.h' 'src/**/*.cpp')
---
Language: Cpp
Standard: Latest
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120

# Opening braces stay on the end of the line (standard modern C++ style).
BreakBeforeBraces: Attach

# Pointers/references bind to the type: Texture* tex, const Animation& anim.
PointerAlignment: Left
DerivePointerAlignment: false

AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: true

# Sort includes deterministically: matching header, C headers, C++ headers,
# then project headers, each block sorted lexically.
# Keep author-controlled include order: Windows.h must precede bcrypt.h etc.
SortIncludes: Never
IncludeBlocks: Preserve
IncludeCategories:
  - Regex: '^"'
    Priority: 4
  - Regex: '^<[^/]+\.h>'
    Priority: 2
  - Regex: '^<'
    Priority: 1

AccessModifierOffset: -4

AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignOperands: true
AlignTrailingComments: true

SpaceBeforeParens: ControlStatements
SpaceBeforeRangeBasedForLoopColon: true
SpaceAfterLogicalNot: false

Cpp11BracedListStyle: true
FixNamespaceComments: true
